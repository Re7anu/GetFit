# FastAPI Settings
PROJECT_NAME="GetFit API"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (for docker-compose postgres)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/getfit"

# LLM AI Configuration (Explicit Provider Keys)
GEMINI_API_KEY="your_primary_gemini_api_key_here"
GEMINI_API_KEY_SECONDARY=""
GROQ_API_KEY="your_groq_api_key_here"
LLM_MODEL_NAME="groq/llama-3.3-70b-versatile"
LLM_FALLBACK_MODEL_NAME="gemini/gemini-2.0-flash"

# Email Configuration (Resend)
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="GetFit Daily <onboarding@resend.dev>"
NIGHTLY_REPORT_HOUR=21
NIGHTLY_REPORT_MINUTE=0

EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER="your-email@gmail.com"
EMAIL_SMTP_PASSWORD="your-app-password"
EMAIL_FROM_EMAIL="noreply@getfit.com"
EMAIL_FROM_NAME="GetFit Nightly Reports"

# Application Running Mode
ENVIRONMENT="development"
